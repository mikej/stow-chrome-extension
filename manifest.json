{
  "manifest_version": 3,
  "name": "Stow",
  "version": "1.0.0",
  "description": "Save the current page to Stow, or edit it if you've already saved it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Save to Stow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "commands": {
    "_execute_action": {
      "description": "Save the current page to Stow",
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      }
    }
  }
}
